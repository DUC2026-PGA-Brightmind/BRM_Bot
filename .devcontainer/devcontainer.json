{
  "name": "BrightMind HR Bot",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.11"
    }
  },
  "postCreateCommand": "pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.pylint"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python"
      }
    }
  },
  "forwardPorts": [],
  "remoteEnv": {
    "BOT_TOKEN": "${localEnv:BOT_TOKEN}",
    "ADMIN_BOT_TOKEN": "${localEnv:ADMIN_BOT_TOKEN}",
    "ADMIN_IDS": "${localEnv:ADMIN_IDS}",
    "MYSQLHOST": "${localEnv:MYSQLHOST}",
    "MYSQLUSER": "${localEnv:MYSQLUSER}",
    "MYSQLPASSWORD": "${localEnv:MYSQLPASSWORD}",
    "MYSQLDATABASE": "${localEnv:MYSQLDATABASE}",
    "MYSQLPORT": "${localEnv:MYSQLPORT}"
  }
}
